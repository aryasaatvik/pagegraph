{
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "react", "bun"],
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "target": "ES2023",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "tests",
    "tegami.config.mts",
    "tsdown.config.mjs",
    "vitest.config.ts",
    "scripts"
  ],
  "exclude": ["tests/fixtures/tanstack-start-app", "tests/fixtures/markdown-start-app"]
}
