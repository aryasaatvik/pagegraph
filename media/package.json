{
  "name": "pagegraph-media",
  "version": "0.0.0",
  "private": true,
  "description": "Launch film, infographics, and social cards for pagegraph. Not published.",
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.ts",
    "scene": "bun scripts/build.ts --scene",
    "preview": "bun run build && hyperframes preview --background launches/introducing-pagegraph",
    "render": "bun run build && bun scripts/render.ts && bun scripts/stills.ts",
    "stills": "bun run build && bun scripts/stills.ts",
    "frames": "bun scripts/frames.ts",
    "copy:audit": "bun scripts/copy.ts",
    "hyperframes": "hyperframes",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test tests"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/spline-sans-mono": "5.3.0",
    "@types/bun": "1.4.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "gsap": "3.15.0",
    "hyperframes": "0.8.150",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "6.0.3"
  }
}
