{
  "name": "pagegraph-site",
  "version": "0.0.0",
  "private": true,
  "description": "pagegraph.arya.sh: the PageGraph landing page and docs, built with PageGraph. Not published.",
  "type": "module",
  "scripts": {
    "sync:media": "node scripts/sync-media.ts",
    "dev": "node scripts/sync-media.ts && cf dev",
    "build": "node scripts/sync-media.ts && cf build",
    "check": "node scripts/sync-media.ts && pagegraph check",
    "typecheck": "tsc --noEmit",
    "deploy": "cf deploy"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/spline-sans-mono": "5.3.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.5",
    "fumadocs-core": "16.18.4",
    "fumadocs-mdx": "15.5.3",
    "marked": "16",
    "pagegraph": "0.18.1",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.16",
    "@tanstack/router-generator": "1.168.0",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "cf": "1.0.0-beta.31",
    "effect": "4.1.2",
    "typescript": "6.0.3",
    "vite": "8.2.4"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
